# Local Docker. Used when the Prisma Postgres variables below are empty.
DATABASE_URL="postgresql://drukalert:drukalert@localhost:5433/drukalert?schema=public"

# Vercel Prisma Postgres (prisma-postgres-red-umbrella). Leave empty for local Docker.
# The pooled URL is for the console and the MQTT worker.
# The Postgres URL is the direct connection used by migrations and seed.
PSQL_DATABASE_DATABASE_URL_POOLED=""
PSQL_DATABASE_POSTGRES_URL=""
PSQL_DATABASE_PRISMA_DATABASE_URL=""

# Used to sign the login cookie. Replace with a long random string.
SESSION_SECRET="replace-with-a-long-random-string"

MQTT_BROKER="broker.hivemq.com"
MQTT_PORT="1883"
MQTT_TOPIC="drukalert/zone/telemetry"

# Optional. Leave the token and chat id blank to skip Telegram alerts.
# TELEGRAM_CHAT_ID can be a numeric chat id, or "auto" to use the latest chat that messaged the bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_LINK="https://t.me/druk_alert_bot"

# Used by prisma db seed. At least 12 characters. Not printed after seeding.
ADMIN_PASSWORD="replace-with-a-long-admin-password"

# Required shared secret on every MQTT packet. The public broker will accept anyone;
# the worker drops packets that do not carry this key. Put the same value in secrets.h.
MQTT_INGEST_KEY="replace-with-a-long-random-string"
